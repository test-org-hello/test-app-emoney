# --- HTTP ---
PORT=4000
# Origin of the web app (CORS)
CORS_ORIGIN=http://localhost:3000

# --- Supabase ---
# Defaults: the local Supabase started by `pnpm db:start`. The key below is the
# standard Supabase CLI demo service_role key (same for every local install, works
# only against the local stack). For a cloud project use its URL and service_role
# key from Project Settings -> API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Circle (Developer-Controlled Wallets) ---
# Real Circle (testnet). For the local mock (`pnpm --filter @circle-wallet/backend circle:fake`)
# use instead:
#   CIRCLE_BASE_URL=http://localhost:4010
#   CIRCLE_API_KEY=TEST_API_KEY:fake:fake
#   CIRCLE_ENTITY_SECRET=abababababababababababababababababababababababababababababababab
CIRCLE_BASE_URL=https://api.circle.com
# TEST_API_KEY:... from https://console.circle.com -> Keys
CIRCLE_API_KEY=
# 32-byte hex. Generate & register: pnpm --filter @circle-wallet/backend circle:entity-secret
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=BASE-SEPOLIA
# SCA wallets get gas sponsored by Circle Gas Station on testnets, so users
# never need native ETH to withdraw. EOA would require funding gas manually.
CIRCLE_ACCOUNT_TYPE=SCA
# Optional: reuse an existing wallet set. If empty, one is created on first use
# and remembered in the app_settings table.
CIRCLE_WALLET_SET_ID=
# Keep true in any shared environment. false only for local curl testing.
CIRCLE_WEBHOOK_VERIFY_SIGNATURE=true

# --- Reconciliation (safety net for missed webhooks) ---
# 0 disables the background job
RECONCILE_INTERVAL_MS=30000
LOG_LEVEL=info
