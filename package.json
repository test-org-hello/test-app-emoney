{
  "name": "circle-wallet",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @circle-wallet/backend --filter @circle-wallet/web dev",
    "dev:backend": "pnpm --filter @circle-wallet/backend dev",
    "dev:web": "pnpm --filter @circle-wallet/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "supabase": "^2.122.1",
    "typescript": "~5.9.3"
  }
}
